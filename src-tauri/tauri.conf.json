{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Mystique",
	"version": "1.0.13",
	"identifier": "com.yashjohri.mystique",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm check && pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Mystique",
				"width": 1440,
				"height": 900,
				"minWidth": 1024,
				"minHeight": 640,
				"maximized": false,
				"resizable": true,
				"fullscreen": false,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMDZFMTc3NDU5OTMxMTkKUldRWk1abEZkK0VHMDQzMWk1bno0c0tnTXl2a1JJWk9GZjhTV1kzbmlRZFFYV2ZUalhxRE50cWsK",
			"endpoints": [
				"https://github.com/yash1200/mystique/releases/latest/download/latest.json"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"bundleName": "Mystique",
			"signingIdentity": "-",
			"hardenedRuntime": true
		}
	}
}
