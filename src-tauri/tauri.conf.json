{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Mystique DB",
	"version": "0.1.0",
	"identifier": "com.yashjohri.mystique-db",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Mystique DB",
				"width": 1440,
				"height": 900,
				"minWidth": 1024,
				"minHeight": 640,
				"maximized": false,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"bundleName": "Mystique DB",
			"signingIdentity": "-"
		}
	}
}
