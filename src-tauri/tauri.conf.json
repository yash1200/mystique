{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Mystique",
	"version": "0.1.0",
	"identifier": "com.yashjohri.mystique",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Mystique",
				"width": 1440,
				"height": 900,
				"minWidth": 1024,
				"minHeight": 640,
				"maximized": false,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDOTNEMTIxRjNCNEU1QkUKUldTKzViVHpJZEdUek1EdEVXeThFbnRtVkNBazFUVThjQ0xpMDVvMGh1NlRxQnVIWU1QRzlmR0sK",
			"endpoints": [
				"https://nova.teachx.ai/trace-analysis/mystique-db/-/releases/permalink/latest/downloads/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"bundleName": "Mystique",
			"signingIdentity": "-"
		}
	}
}
