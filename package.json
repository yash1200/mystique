{
	"name": "mystique",
	"version": "1.0.0",
	"description": "A modern database IDE built with SvelteKit, Tauri, and TailwindCSS.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && node scripts/check-boundaries.mjs && svelte-check --tsconfig ./tsconfig.json",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:crates": "node scripts/check-crate-layers.mjs",
		"gen:ipc": "cargo run -q -p mystique-ipc-gen --features ts --locked",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"tauri:build:x86": "tauri build --target x86_64-apple-darwin",
		"tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc"
	},
	"packageManager": "pnpm@12.14.0",
	"license": "MIT",
	"dependencies": {
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-sql": "6.10.0",
		"@codemirror/language": "6.12.4",
		"@codemirror/lint": "6.9.2",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/theme-one-dark": "6.1.3",
		"@codemirror/view": "6.43.13",
		"@lezer/highlight": "1.2.5",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-dialog": "2.8.3",
		"@tauri-apps/plugin-fs": "2.7.1",
		"@tauri-apps/plugin-opener": "2.7.2",
		"codemirror": "6.0.2",
		"html-to-image": "1.11.13",
		"sql-formatter": "15.9.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tauri-apps/cli": "2.12.4",
		"happy-dom": "21.0.4",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"imports": {
		"#core/contracts": "./src/lib/core/contracts/index.js",
		"#core/commands": "./src/lib/core/commands/index.js",
		"#core/ipc": "./src/lib/core/ipc/index.js",
		"#core/ui": "./src/lib/core/ui/index.js",
		"#core/util": "./src/lib/core/util/index.js",
		"#features/connections": "./src/lib/features/connections/index.js",
		"#features/settings": "./src/lib/features/settings/index.js",
		"#features/shortcuts": "./src/lib/features/shortcuts/index.js",
		"#features/toast": "./src/lib/features/toast/index.js",
		"#features/workspace": "./src/lib/features/workspace/index.js",
		"#features/workspace/agent": "./src/lib/features/workspace/agent/index.js",
		"#features/workspace/catalog": "./src/lib/features/workspace/catalog/index.js",
		"#features/workspace/data-grid": "./src/lib/features/workspace/data-grid/index.js",
		"#features/workspace/er": "./src/lib/features/workspace/er/index.js",
		"#features/workspace/explorer": "./src/lib/features/workspace/explorer/index.js",
		"#features/workspace/grid": "./src/lib/features/workspace/grid/index.js",
		"#features/workspace/metrics": "./src/lib/features/workspace/metrics/index.js",
		"#features/workspace/query": "./src/lib/features/workspace/query/index.js",
		"#features/workspace/quick-open": "./src/lib/features/workspace/quick-open/index.js",
		"#features/workspace/session": "./src/lib/features/workspace/session/index.js",
		"#features/workspace/shell": "./src/lib/features/workspace/shell/index.js",
		"#features/workspace/structure": "./src/lib/features/workspace/structure/index.js",
		"#features/workspace/table": "./src/lib/features/workspace/table/index.js",
		"#features/workspace/transfer": "./src/lib/features/workspace/transfer/index.js",
		"#lib/app": "./src/lib/app/index.js",
		"#lib/*": "./src/lib/*",
		"#core/*": "./src/lib/core/*",
		"#engines": "./src/lib/engines/index.js",
		"#engines/*": "./src/lib/engines/*",
		"#features/*": "./src/lib/features/*",
		"#icons": "./src/assets/icons/index.js",
		"#icons/*": "./src/assets/icons/*",
		"#illustrations": "./src/assets/illustrations/index.js",
		"#illustrations/*": "./src/assets/illustrations/*"
	}
}
